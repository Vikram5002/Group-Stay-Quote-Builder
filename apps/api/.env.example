# API environment. Copy to .env for local runs; no real secrets belong in this file.
# Locally only DYNAMODB_ENDPOINT is needed (DynamoDB Local in Docker). In AWS the CDK stack sets
# the rest on the Lambda functions.

# Local DynamoDB (npm run db:up -w @c32/api). Leave unset in AWS.
DYNAMODB_ENDPOINT=http://localhost:8100
# Port for the local Express server.
PORT=3000
# Comma-separated browser origins allowed by CORS (the web dev server locally).
CORS_ORIGINS=http://localhost:5173
# Folder for local imports, exports and the email outbox (.eml files).
LOCAL_FILES_DIR=.local-files
# Silence request logs (tests).
LOG_SILENT=0

# --- Set by CDK in AWS (shown for reference) ---
# TABLE_NAME=c32-dev-main
# PROPERTY_ID=p1
# DOCS_BUCKET=<docs bucket name>
# SENDER_EMAIL=<verified SES sender address>
# AWS_REGION=ap-south-1
# APP_VERSION=dev-<git sha>
# Only for seeding a real AWS table on purpose:
# SEED_ALLOW_AWS=1
