{
  "name": "@c32/api",
  "version": "0.1.0",
  "private": true,
  "description": "Express API for the Group Stay Quote Builder. Runs locally and in Lambda.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/local.ts",
    "start": "tsx src/local.ts",
    "db:up": "docker run -d --rm --name c32-dynamodb -p 8100:8000 public.ecr.aws/aws-dynamodb-local/aws-dynamodb-local:3.3.2 -jar DynamoDBLocal.jar -inMemory -sharedDb",
    "db:down": "docker stop c32-dynamodb",
    "seed": "tsx src/seed.ts",
    "bundle": "node scripts/bundle.mjs && node scripts/smoke-bundle.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-scheduler": "^3.1152.0",
    "@aws-sdk/client-sesv2": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@c32/core": "0.1.0",
    "@codegenie/serverless-express": "^5.0.0",
    "express": "^5.3.0",
    "pdf-lib": "^1.17.1",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1"
  }
}
