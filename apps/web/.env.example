# Default for local development: in-browser mock API, no backend needed.
VITE_API_MODE=mock

# To use the real local API instead (see the README, "Run against the real API"):
# VITE_API_MODE=api
# VITE_API_BASE_URL=http://localhost:3000
# VITE_AUTH_MODE=dev

# A deployed site (set by the deploy workflow from the stack outputs):
# VITE_API_MODE=api
# VITE_API_BASE_URL=https://<api-id>.execute-api.ap-south-1.amazonaws.com
# VITE_AUTH_MODE=cognito
# VITE_COGNITO_DOMAIN=https://<prefix>.auth.ap-south-1.amazoncognito.com
# VITE_COGNITO_CLIENT_ID=<app client id>
